---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { exhibits, exhibitPath } from "../data/exhibits";
---
<BaseLayout title="AI in Perspective" description="Explore six questions about AI in an original immersive museum of evidence, perspective and discovery." bodyClass="museum-body">
  <SiteHeader />
  <main id="content">
    <section class="atrium" aria-labelledby="atrium-title">
      <div class="atrium-sky" aria-hidden="true">
        <div class="atrium-nebula"></div>
        <div class="atrium-arch atrium-arch--left"></div>
        <div class="atrium-arch atrium-arch--right"></div>
        <div class="atrium-floor"></div>
      </div>
      <div class="atrium-hero">
        <p class="eyebrow"><span class="eyebrow-line"></span> A MUSEUM OF AI QUESTIONS <span class="eyebrow-line"></span></p>
        <h1 id="atrium-title">Beyond the noise.<br /><em>Into perspective.</em></h1>
        <p class="atrium-lede">What if understanding AI started with a better question? Step inside six explorations of what is real, what is exaggerated, and what the evidence says.</p>
        <a href="#exhibits" class="text-action">Enter the exhibits <span aria-hidden="true">↓</span></a>
      </div>
      <div class="atrium-lens" aria-hidden="true">
        <div class="atrium-lens-outer"></div>
        <div class="atrium-lens-inner"></div>
        <div class="atrium-lens-core"></div>
        <div class="atrium-lens-scan"></div>
      </div>
      <p class="atrium-caption">SIX QUESTIONS. MANY PERSPECTIVES. YOUR CONCLUSIONS.</p>
    </section>

    <section class="hall" id="exhibits" aria-labelledby="hall-title">
      <div class="hall-inner">
        <div class="section-intro">
          <div>
            <p class="eyebrow">THE EXHIBITION HALL / 01—06</p>
            <h2 id="hall-title">Choose a question.<br /><span>Enter another world.</span></h2>
          </div>
          <p>Every doorway opens a different way of looking at AI. The experience is immersive. The explanations are grounded in evidence.</p>
        </div>
        <div class="installation-grid">
          {exhibits.map((exhibit) => (
            <a href={exhibitPath(exhibit.slug)} class:list={["installation", `installation--${exhibit.visual}`]} aria-label={`Explore ${exhibit.title}`}>
              <span class="installation-visual" aria-hidden="true">
                <span class="installation-vault"></span>
                <svg class="installation-symbol" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
                  {exhibit.visual === "signal" && <g stroke="currentColor" stroke-width="1.2"><path d="M100 22L172 155H28L100 22Z" opacity=".6"/><path d="M100 48L148 139H52L100 48Z"/><circle cx="100" cy="106" r="24"/><path d="M100 78V114M100 125V129" stroke-width="4" stroke-linecap="round"/><path d="M30 45L61 65M167 50L144 73M39 155L70 145M158 162L134 144" opacity=".5"/></g>}
                  {exhibit.visual === "mind" && <g stroke="currentColor" stroke-width="1.1"><circle cx="100" cy="100" r="72" opacity=".3"/><circle cx="100" cy="100" r="48" stroke-dasharray="3 6"/><path d="M63 95Q38 58 77 47Q89 23 109 53Q151 43 149 77Q175 114 143 128Q132 161 98 146Q66 163 58 133Q31 124 63 95Z"/><path d="M75 65L115 78L137 111L102 135L72 115L75 65L102 89L137 111M115 78L102 135" opacity=".65"/><circle cx="102" cy="89" r="5" fill="currentColor"/></g>}
                  {exhibit.visual === "water" && <g stroke="currentColor" stroke-width="1.3"><path d="M100 22C86 51 48 87 48 118C48 147 70 170 100 170C130 170 152 147 152 118C152 87 114 51 100 22Z"/><path d="M73 116C74 95 85 84 95 70" stroke-width="5" stroke-linecap="round" opacity=".6"/><ellipse cx="100" cy="133" rx="36" ry="12" opacity=".4"/><path d="M62 144C88 128 117 165 145 141" opacity=".55"/><circle cx="100" cy="117" r="9" fill="currentColor" fill-opacity=".26"/></g>}
                  {exhibit.visual === "benefits" && <g stroke="currentColor" stroke-width="1.2"><circle cx="100" cy="100" r="67" opacity=".35"/><path d="M100 35V165M35 100H165M54 54L146 146M146 54L54 146" opacity=".25"/><path d="M100 62L109 91L139 100L109 109L100 139L91 109L61 100L91 91Z" fill="currentColor" fill-opacity=".25"/><circle cx="100" cy="100" r="8" fill="currentColor"/></g>}
                  {exhibit.visual === "prism" && <g stroke="currentColor" stroke-width="1.2"><path d="M100 30L170 149H30L100 30Z"/><path d="M100 30V149M30 149L136 89M170 149L64 89" opacity=".6"/><path d="M23 104L80 104M120 104H178" stroke-width="3"/><path d="M168 100L185 80M168 106L188 107M167 112L185 135" stroke-width="2" opacity=".65"/><circle cx="100" cy="103" r="14" fill="currentColor" fill-opacity=".15"/></g>}
                  {exhibit.visual === "network" && <g stroke="currentColor" stroke-width="1.2"><path d="M100 37L152 71V129L100 163L48 129V71L100 37Z" opacity=".5"/><path d="M100 37V100L48 129M100 100L152 129M48 71L100 100L152 71"/><circle cx="100" cy="37" r="8" fill="#091525"/><circle cx="152" cy="71" r="7" fill="#091525"/><circle cx="48" cy="71" r="7" fill="#091525"/><circle cx="100" cy="100" r="12" fill="currentColor" fill-opacity=".23"/><circle cx="100" cy="163" r="6" fill="#091525"/></g>}
                </svg>
                <span class="installation-halo"></span>
              </span>
              <span class="installation-copy">
                <span class="installation-meta"><span>{exhibit.number} / {exhibit.kicker}</span><span class="installation-arrow" aria-hidden="true">↗</span></span>
                <span class="installation-title">{exhibit.title}</span>
                <span class="installation-desc">{exhibit.short}</span>
                <span class="installation-foot"><span>{exhibit.kind}</span><span>{exhibit.status === "prototype" ? "Explore prototype" : "Preview exhibit"}</span></span>
              </span>
            </a>
          ))}
        </div>
        <p class="hall-footnote">This is a development preview. The Environment experience is the first working exhibit prototype; the other five are identified as planned.</p>
      </div>
    </section>
    <section class="closing-band" aria-label="Our purpose"><p>The first impression is not always the whole picture.</p><h2>The choice begins with <em>understanding.</em></h2><a href="/methodology" class="text-action">How we approach the evidence <span aria-hidden="true">↗</span></a></section>
  </main>
  <footer class="site-footer"><span>AI in Perspective · An evolving museum of understanding</span><a href="/intro">Replay introduction</a></footer>
</BaseLayout>
