import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
---
<BaseLayout title="How we approach the evidence" description="How AI in Perspective distinguishes claims, measurements, experiments, estimates and interpretation." bodyClass="exhibit-body">
  <SiteHeader subtle />
  <main id="content" class="method-page">
    <a href="/discover/" class="back-link">← All perspectives</a>
    <p class="eyebrow">BEHIND THE RESEARCH</p>
    <h1>Wonder is the invitation.<br /><em>Evidence is the foundation.</em></h1>
    <p class="method-lede">AI in Perspective exists to make difficult questions understandable without confusing a compelling story with a proven fact.</p>
    <div class="method-grid">
      <section><span class="method-index">01</span><h2>Start with the question</h2><p>We identify the claim a reader is trying to understand before choosing what evidence or visualization belongs on the page.</p></section>
      <section><span class="method-index">02</span><h2>Go to the original source</h2><p>Important numbers and dated claims require traceable studies, original datasets, official statements or credible documentation. An article mentioning a study is a lead, not the study itself.</p></section>
      <section><span class="method-index">03</span><h2>Separate evidence types</h2><p>Measured observations, documented incidents, laboratory demonstrations, modeled estimates, predictions and interpretations answer different questions. We identify those differences rather than compressing them into one rating.</p></section>
      <section><span class="method-index">04</span><h2>Show the uncertainty</h2><p>Units, boundaries, dates, alternative explanations, missing evidence and contested conclusions belong alongside the claim, especially in charts and interactive comparisons.</p></section>
      <section><span class="method-index">05</span><h2>Review before publishing</h2><p>Research and model-assisted discovery are not publication. Substantive findings should receive independent verification and human editorial approval.</p></section>
      <section><span class="method-index">06</span><h2>Update without rewriting history</h2><p>Changing evidence should lead to dated corrections and visible source review, not silent replacement of the past.</p></section>
    </div>
    <p class="method-disclaimer">Development status: this page describes the intended editorial process. It is not a claim that research verification or publication approval for the unfinished topic pages has already occurred.</p>
  </main>
</BaseLayout>
