---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="The choice begins with understanding" description="A moment to consider what understanding AI makes possible." bodyClass="intro-body">
  <main id="content" class="intro-stage">
    <div class="intro-stars" aria-hidden="true"></div>
    
    <div class="intro-earth-aura" aria-hidden="true"></div>
    <div class="intro-space-haze" aria-hidden="true"></div>
    <div class="intro-planet" aria-hidden="true">
      <svg class="intro-earth-art" viewBox="0 0 1000 1000" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <radialGradient id="intro-earth-ocean" cx="38%" cy="27%" r="75%">
            <stop offset="0%" stop-color="#194f74"/>
            <stop offset="37%" stop-color="#0b304b"/>
            <stop offset="72%" stop-color="#071a30"/>
            <stop offset="100%" stop-color="#020914"/>
          </radialGradient>
          <radialGradient id="intro-earth-illumination" cx="38%" cy="18%" r="76%">
            <stop offset="0%" stop-color="#a1e9f8" stop-opacity=".28"/>
            <stop offset="44%" stop-color="#36a8d3" stop-opacity=".06"/>
            <stop offset="100%" stop-color="#091e37" stop-opacity=".3"/>
          </radialGradient>
          <linearGradient id="intro-earth-atmosphere" x1="0%" y1="0%" x2="85%" y2="95%">
            <stop offset="0%" stop-color="#dffeff" stop-opacity=".85"/>
            <stop offset="26%" stop-color="#46d1ed" stop-opacity=".78"/>
            <stop offset="65%" stop-color="#2087bd" stop-opacity=".43"/>
            <stop offset="100%" stop-color="#061c3a" stop-opacity=".3"/>
          </linearGradient>
          <clipPath id="intro-earth-clip"><circle cx="500" cy="500" r="450"/></clipPath>
        </defs>
        <circle class="intro-earth-bloom" cx="500" cy="500" r="456" fill="none" stroke="#55c7f5" stroke-opacity=".18" stroke-width="48"/>
        <circle cx="500" cy="500" r="450" fill="url(#intro-earth-ocean)" stroke="url(#intro-earth-atmosphere)" stroke-width="4"/>
        <g clip-path="url(#intro-earth-clip)">
          <g fill="none" stroke="#5ab1d8" stroke-opacity=".20" stroke-width="1.2">
            <ellipse cx="500" cy="500" rx="450" ry="104"/>
            <ellipse cx="500" cy="500" rx="450" ry="245"/>
            <ellipse cx="500" cy="500" rx="450" ry="368"/>
            <ellipse cx="500" cy="500" rx="150" ry="450"/>
            <ellipse cx="500" cy="500" rx="318" ry="450"/>
            <path d="M50 500H950M500 50V950" opacity=".3"/>
          </g>
          <g class="intro-earth-land" fill="#73d4d9" fill-opacity=".19" stroke="#93e8ed" stroke-opacity=".54" stroke-width="2.3" stroke-linejoin="round">
            <path d="M202 307L249 284L272 250L302 249L330 223L361 237L388 221L420 231L451 211L478 221L506 213L535 226L566 207L594 231L633 222L655 246L698 250L714 273L755 283L784 306L824 302L845 326L825 345L838 367L805 382L785 407L754 397L731 418L702 408L681 434L656 411L624 419L594 398L559 408L534 391L499 413L470 402L445 416L417 398L389 407L364 386L327 395L310 373L272 369L252 344L222 342Z"/>
            <path d="M357 412L400 399L441 409L468 429L489 461L487 500L520 533L512 570L493 594L480 626L451 648L439 687L411 714L382 706L374 674L349 646L333 606L315 587L308 545L292 517L307 489L311 460L337 444Z"/>
            <path d="M561 417L600 421L620 451L641 459L655 486L640 504L610 496L592 464Z"/>
            <path d="M693 433L728 446L751 478L746 514L718 545L709 526L706 486Z"/>
            <path d="M780 495L814 503L825 528L808 544L791 534Z"/>
            <path d="M407 270L420 244L444 252L437 276Z"/>
            <path d="M466 267L490 239L508 256L506 279Z"/>
            <path d="M228 383L257 382L270 409L244 425L221 407Z"/>
            <path d="M528 696L544 712L532 759L519 745Z"/>
          </g>
          <g stroke="#99dcf2" stroke-opacity=".24" stroke-width="1.4" fill="none">
            <path d="M301 300L387 355L455 317L536 349L616 306L713 337L794 359"/>
            <path d="M362 419L440 473L420 553L385 625"/>
            <path d="M528 342L601 438L717 471"/>
          </g>
          <g fill="#b7efff" opacity=".85">
            <circle cx="301" cy="300" r="3.5"/><circle cx="387" cy="355" r="4"/><circle cx="455" cy="317" r="3"/><circle cx="536" cy="349" r="4.2"/><circle cx="616" cy="306" r="2.6"/><circle cx="713" cy="337" r="3"/><circle cx="794" cy="359" r="3.5"/><circle cx="362" cy="419" r="3"/><circle cx="440" cy="473" r="3.5"/><circle cx="420" cy="553" r="2.5"/><circle cx="385" cy="625" r="3"/><circle cx="601" cy="438" r="3.4"/><circle cx="717" cy="471" r="3.2"/>
          </g>
          <circle cx="500" cy="500" r="450" fill="url(#intro-earth-illumination)"/>
          <ellipse cx="360" cy="140" rx="290" ry="120" fill="#c8f8ff" opacity=".07"/>
        </g>
        <path d="M63 385A450 450 0 0 1 916 328" fill="none" stroke="#baf8ff" stroke-opacity=".42" stroke-width="5" stroke-linecap="round"/>
      </svg>
    </div>
    <div class="intro-center">
      <a href="/" class="intro-brand" aria-label="AI in Perspective museum hall">AI <span>in Perspective</span></a>
      <div class="intro-message" aria-label="Opening statement">
        <h1 class="intro-line intro-line--first"><span class="intro-headline-lead">AI HAS</span> <span class="intro-headline-arrived">ARRIVED</span></h1>
        <p class="intro-line">You can choose to ignore it. You can resist it, fear it, or close yourself off from it. Or you can choose to understand it, explore what it makes possible, and empower yourself with it.</p>
        <p class="intro-line">There are real risks, and they deserve to be taken seriously. But the truth is, <em>right now</em>, AI is less something to fear and more something to be excited about.</p>
        <p class="intro-line">You don't have to embrace everything about AI to recognize its potential. And you don't have to ignore its risks to be optimistic about its future.</p>
        <p class="intro-line intro-line--final">The choice begins with <em>understanding.</em></p>
      </div>
      <a href="/" class="intro-continue">Continue to the museum <span aria-hidden="true">→</span></a>
    </div>
    <a href="/" class="intro-skip">Skip introduction <span aria-hidden="true">↗</span></a>
    <span class="intro-caption" aria-hidden="true">PERSPECTIVE BEGINS HERE</span>
  </main>
  <script>
    // Keep the action visible without waiting for animation. Motion never blocks entry.
    const stage = document.querySelector(".intro-stage");
    stage?.classList.add("intro-ready");
  </script>
</BaseLayout>
