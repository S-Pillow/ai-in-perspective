---
import { createHash } from "node:crypto";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { NEWS_LENSES, NEWS_SOURCES, NEWS_STORIES, validateEditorialPreview } from "../../data/newsEditorial.mjs";
import savedNewsSnapshot from "../../data/news-snapshot.json";
import { validateSnapshot } from "../../../scripts/news/feed-core.mjs";
import { ENABLED_NEWS_FEEDS } from "../../data/newsFeeds.mjs";
import { getVisibleFeedArticles, formatSnapshotTimeUtc } from "../../data/newsPresentation.mjs";
import "../../styles/education-news.css";
import "../../styles/news-room.css";

validateEditorialPreview();
const lead = NEWS_STORIES.find((story) => story.featured);
const otherStories = NEWS_STORIES.filter((story) => !story.featured);
const feedSnapshot = validateSnapshot(savedNewsSnapshot);
const snapshotDigest = createHash("sha256").update(JSON.stringify(feedSnapshot)).digest("hex");
// Display links from every publisher without repeating any of the curated stories.
const latestArticles = getVisibleFeedArticles(feedSnapshot.articles, ENABLED_NEWS_FEEDS, NEWS_STORIES, 16);
const feedSourceType = (value) => ({preprint:"Preprint · not peer reviewed by default",company_announcement:"Company announcement · attributed claim",independent_reporting:"Independent reporting",university:"University research report"})[value] ?? "Publisher article";
const feedStatusLabel = (value) => ({preprint:"Preprint",attributed_primary_source:"Provider report",unreviewed:"Not independently verified",independent_reporting:"Independently reported",corroborated:"Independently corroborated"})[value] ?? "Source link";
const formatDate = (date) => new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" }).format(new Date(date + "T12:00:00Z"));
---
<BaseLayout title="AI News & Perspective | AI in Perspective" description="Explore curated AI stories and attributed publisher links across five editorial lenses, with clear evidence labels and dated source snapshots." bodyClass="exhibit-body">
  <SiteHeader subtle />
  <main class="en-soon en-newsroom" id="content" data-newsroom>
    <div class="en-sky" aria-hidden="true"></div>

    <section class="en-hero nr-hero" aria-labelledby="en-title">
      <div class="en-hero__nav">
        <a class="en-back" href="/explore/education-news">← Education</a>
        <nav class="en-section-switch" aria-label="Education and News sections">
          <a href="/explore/education-news">Education</a>
          <a href="/explore/news" aria-current="page">News</a>
        </nav>
      </div>
      <div class="nr-hero__grid">
        <p class="en-eyebrow"><span class="nr-eyebrow-mark" aria-hidden="true"></span> PERSPECTIVE / NEWS DESK</p>
        <h1 id="en-title">News <span>&amp;</span> Perspective<span class="nr-title-dot">.</span></h1>
        <p class="en-lead">The useful, troubling, remarkable, and important things happening in AI, with the original reporting close at hand and enough context to think for yourself.</p>
        <div class="en-hero__actions">
          <a class="en-primary" href="#source-feed">Browse source links <span aria-hidden="true">↓</span></a>
          <a class="en-quiet" href="#our-approach">How we choose them <span aria-hidden="true">↘</span></a>
        </div>
      </div>
    </section>

    <section class="nr-stories" id="stories" aria-labelledby="nr-stories-title">
      <div class="nr-stories__heading">
        <div><p class="en-eyebrow">SELECTED STORIES / ORIGINAL SOURCES</p><h2 id="nr-stories-title">Five stories. Five ways to look closer.</h2></div>
        <p>Research findings, company announcements, and independent reporting don't carry the same kind of evidence. Each story explains which kind you're reading.</p>
      </div>
      <div class="nr-filters" role="group" aria-label="Filter stories by perspective">
        <button type="button" class="nr-filter" data-news-filter="All" aria-pressed="true">All stories</button>
        {NEWS_LENSES.map((lens) => <button type="button" class="nr-filter" data-news-filter={lens} aria-pressed="false">{lens}</button>)}
      </div>
      <p class="nr-results" data-news-results aria-live="polite" aria-atomic="true">Showing all {NEWS_STORIES.length} stories</p>

      <div class="nr-story-grid" data-news-grid>
        <article class="nr-lead" data-news-item data-news-lens={lead.lens}>
          <div class="nr-lead__art" aria-hidden="true"><span class="nr-lead__ring nr-lead__ring--one"></span><span class="nr-lead__ring nr-lead__ring--two"></span><span class="nr-lead__cross">+</span><span class="nr-lead__art-label">IN FOCUS / 01</span></div>
          <div class="nr-lead__body">
            <div class="nr-story__top"><span class="nr-story__tag">{lead.lens}</span><span class="nr-story__type">{lead.sourceType}</span></div>
            <p class="nr-story__source">{lead.publisher} <span aria-hidden="true">·</span> <time datetime={lead.publishedAt}>{formatDate(lead.publishedAt)}</time></p>
            <h3><a href={lead.url} target="_blank" rel="noopener noreferrer">{lead.title} <span aria-hidden="true">↗</span></a></h3>
            <p class="nr-story__context">{lead.context}</p>
            <p class="nr-story__evidence"><span class="nr-evidence__mark" aria-hidden="true"></span>{lead.evidenceStatus}</p>
            <a class="nr-story__read" href={lead.url} target="_blank" rel="noopener noreferrer">Read the original at {lead.publisher} <span aria-hidden="true">↗</span></a>
          </div>
        </article>
        <div class="nr-stack">
          {otherStories.map((story, index) =>
            <article class="nr-item" data-news-item data-news-lens={story.lens}>
              <div class="nr-item__number" aria-hidden="true">0{index + 2}</div>
              <div class="nr-item__content">
                <div class="nr-story__top"><span class="nr-story__tag">{story.lens}</span><span class="nr-story__type">{story.sourceType}</span></div>
                <p class="nr-story__source">{story.publisher} <span aria-hidden="true">·</span> <time datetime={story.publishedAt}>{formatDate(story.publishedAt)}</time></p>
                <h3><a href={story.url} target="_blank" rel="noopener noreferrer">{story.title} <span aria-hidden="true">↗</span></a></h3>
                <p class="nr-story__context">{story.context}</p>
                <p class="nr-story__evidence"><span class="nr-evidence__mark" aria-hidden="true"></span>{story.evidenceStatus}</p>
              </div>
            </article>
          )}
        </div>
      </div>
      <p class="nr-empty" data-news-empty hidden>No selected stories match this perspective. Try another category.</p>
      <p class="nr-disclaimer">The five selected stories are curated manually. Collected source links come from a dated saved snapshot, not a real-time feed. Daily collection checks for changes before publication. Article claims are attributed to their publishers, not automatically fact-checked. No third-party article text or photographs are republished here.</p>
    </section>


    <section class="nr-feed" id="source-feed" aria-labelledby="nr-feed-title" data-news-snapshot-sha256={snapshotDigest}>
      <div class="nr-feed__intro">
        <div>
          <p class="en-eyebrow">SOURCE SNAPSHOT / NEWS DATA</p>
          <h2 id="nr-feed-title">Articles from across the sources.</h2>
          <p>Feed entries are sampled across publishers, without repeating the curated stories above. The newest links from each source have no automatically assigned editorial perspective or independent fact-check. Check the original source before relying on a claim.</p>
        </div>
        <div class="nr-feed__status" aria-label="News snapshot status">
          <span>{latestArticles.length ? "SAVED SNAPSHOT" : "COLLECTION NOT PUBLISHED"}</span>
          <strong><time datetime={feedSnapshot.publishedAt ?? undefined}>{feedSnapshot.publishedAt ? formatSnapshotTimeUtc(feedSnapshot.publishedAt) : "Awaiting first checked update"}</time></strong>
          <small>{latestArticles.length ? "This is when the saved snapshot changed (UTC), not a live-feed refresh." : "No validated source links are currently available."}</small>
        </div>
      </div>
      {latestArticles.length ? (
        <div class="nr-feed__list">
          {latestArticles.map((article) =>
            <article class="nr-feed__item">
              <div class="nr-feed__meta"><span>{article.publisher}</span><span>{feedSourceType(article.sourceType)}</span></div>
              <h3><a href={article.url} target="_blank" rel="noopener noreferrer">{article.title} <span aria-hidden="true">↗</span></a></h3>
              <div class="nr-feed__bottom">
                <time datetime={article.publishedAt ?? undefined}>{article.publishedAt ? formatDate(article.publishedAt.slice(0,10)) : "Date not provided"}</time>
                <span>{feedStatusLabel(article.evidenceStatus)}</span>
              </div>
            </article>
          )}
        </div>
      ) : (
        <div class="nr-feed__empty">
          <strong>No automatic feed snapshot has been published yet.</strong>
          <p>The five editor-picked links above are still available to explore.</p>
        </div>
      )}
    </section>

    <section class="nr-approach" id="our-approach" aria-labelledby="nr-approach-title">
      <div class="nr-approach__intro"><p class="en-eyebrow">WHAT WE CHECK</p><h2 id="nr-approach-title">A headline is the beginning of the question.</h2><p>A story is easier to understand when you know who reported it, what actually happened, and which parts are still uncertain.</p></div>
      <div class="nr-approach__grid">
        <article><span>01 / SOURCE</span><h3>Who is saying it?</h3><p>We distinguish independent reporting, university research, preprints, and first-party company announcements. Each article points back to its source.</p></article>
        <article><span>02 / EVIDENCE</span><h3>What is established?</h3><p>An experiment isn't a product rollout. A company claim isn't independent confirmation. A preprint isn't automatically peer-reviewed.</p></article>
        <article><span>03 / CONTEXT</span><h3>Why does it matter?</h3><p>Look past novelty and hype to the people affected, real limits, and unanswered questions. Different perspectives can belong in the same news cycle.</p></article>
      </div>
    </section>

    <section class="nr-sources" aria-labelledby="nr-sources-title">
      <div class="nr-sources__intro"><p class="en-eyebrow">THE SOURCE DESK</p><h2 id="nr-sources-title">Eight starting points. More voices to follow.</h2><p>The source list mixes research, independent reporting, and AI companies. Six native feeds are configured for daily headline-and-link collection. MIT Technology Review and Anthropic remain discovery links only; Anthropic's official RSS is not verified.</p></div>
      <div class="nr-sources__list">
        {NEWS_SOURCES.map((source) =>
          <a href={source.url} class="nr-source" target="_blank" rel="noopener noreferrer">
            <span class="nr-source__name">{source.name}</span><span class="nr-source__type">{source.type}</span><span aria-hidden="true">↗</span>
          </a>
        )}
      </div>
    </section>

    <section class="en-arcade nr-arcade" id="arcade" aria-labelledby="en-arcade-title">
      <div class="en-section-heading">
        <div><p class="en-eyebrow en-eyebrow--pink">A LITTLE ARCADE INTERMISSION</p><h2 id="en-arcade-title">Take an arcade break.</h2><p>The original pixel-fighter animation is still here, with its license and replay controls. It is separate from the news content.</p></div>
        <div class="en-arcade__mark" aria-hidden="true">★<span>05</span></div>
      </div>
      <div class="en-arcade__cabinet">
        <div class="en-arcade__top"><span><span class="en-arcade__led" aria-hidden="true"></span> ARCADE MODE</span><span>AI IN PERSPECTIVE / 05</span></div>
        <iframe id="en-fighter" class="en-arcade__frame" title="Retro pixel-art fighter animation. Use the Replay animation button to start over." src="/arcade/education-news-fighter.html" loading="lazy" tabindex="-1" sandbox="allow-scripts" referrerpolicy="no-referrer"></iframe>
        <div class="en-arcade__bottom">
          <p>A short animated fighter combo. Click inside the scene to replay it, or use the button. <a href="/licenses/instalanding-MIT-LICENSE.txt" target="_blank" rel="noopener noreferrer">Animation license and credit</a>.</p>
          <button type="button" class="en-replay" data-en-replay><span aria-hidden="true">↻</span> Replay animation</button>
        </div>
      </div>
    </section>
    <footer class="en-footer"><span>AI IN PERSPECTIVE · NEWS / SOURCES & CONTEXT</span><a href="/explore/education-news">Explore AI in Education <span aria-hidden="true">↗</span></a></footer>
  </main>
  <script>
    const replayButton = document.querySelector("button[data-en-replay]");
    const fighterFrame = document.getElementById("en-fighter");
    if (replayButton && fighterFrame) {
      let playNumber = 0;
      replayButton.addEventListener("click", () => {
        playNumber += 1;
        fighterFrame.setAttribute("src", "/arcade/education-news-fighter.html?replay=" + playNumber);
      });
    }
    const filters = Array.from(document.querySelectorAll("button[data-news-filter]"));
    const items = Array.from(document.querySelectorAll("[data-news-item]"));
    const resultLine = document.querySelector("[data-news-results]");
    const empty = document.querySelector("[data-news-empty]");
    for (const filter of filters) {
      filter.addEventListener("click", () => {
        const active = filter.getAttribute("data-news-filter");
        for (const button of filters) button.setAttribute("aria-pressed", button === filter ? "true" : "false");
        let showing = 0;
        for (const item of items) {
          const match = active === "All" || item.getAttribute("data-news-lens") === active;
          item.hidden = !match;
          if (match) showing++;
        }
        if (empty) empty.hidden = showing !== 0;
        if (resultLine) resultLine.textContent = showing === 0 ? "No stories in this selection" : "Showing " + showing + " of " + items.length + " stories";
      });
    }
  </script>
</BaseLayout>
